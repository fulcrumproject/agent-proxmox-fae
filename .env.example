# Proxmox Agent Environment Configuration

# Fulcrum API Connection
PROXMOX_AGENT_FULCRUM_API_URL=http://localhost:3000
PROXMOX_AGENT_FULCRUM_API_TOKEN=AGENT-SECRET-TOKEN

# Job and Metric Intervals (time.Duration format)
PROXMOX_AGENT_JOB_POLL_INTERVAL=5s
PROXMOX_AGENT_METRIC_REPORT_INTERVAL=30s

# Logging Configuration
PROXMOX_AGENT_LOG_FORMAT=json
PROXMOX_AGENT_LOG_LEVEL=info
