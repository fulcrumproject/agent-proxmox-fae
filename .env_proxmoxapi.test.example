# FAE base URL(s), without /docs, /pve or /api2/json.
# Integration tests require exactly one dedicated test endpoint.
PROXMOX_AGENT_PROXMOX_API_URLS=https://fae-test.example:5297
PROXMOX_AGENT_PROXMOX_API_TOKEN=REPLACE_WITH_FAE_TOKEN
PROXMOX_AGENT_PROXMOX_API_INSECURE_SKIP_TLS=false
PROXMOX_AGENT_PROXMOX_API_TIMEOUT=30
PROXMOX_AGENT_PROXMOX_API_DEBUG=false

# Required only for TestClientVMLifecycle. Reserve an unused IPv4 address on
# the infrastructure bridge (vmbr); do not reuse an address from another VM.
# Pick a Linux cloud-init template with a base disk no larger than 20 GiB.
PROXMOX_AGENT_TEST_TEMPLATE=
PROXMOX_AGENT_TEST_IPADDRESS=
PROXMOX_AGENT_TEST_NETMASK=
PROXMOX_AGENT_TEST_GATEWAY=

# Optional DNS settings and console test (VNC is skipped without a source IP).
PROXMOX_AGENT_TEST_NAMESERVER=
PROXMOX_AGENT_TEST_SEARCHDOMAIN=
PROXMOX_AGENT_TEST_VNC_SOURCE_IP=
