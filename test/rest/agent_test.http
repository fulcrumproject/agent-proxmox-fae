GET {{baseUrl}}/services/{{serviceId}}
Authorization: Bearer {{consumerToken}}

### Cold update vm status (VM is stopped)
PATCH {{baseUrl}}/services/{{serviceId}}
Authorization: Bearer {{consumerToken}}

{
    "properties": {
        "cpu": 4,
        "memory": 4096,
        "firewallrules": [
            {
                "type": "in",
                "proto": "tcp",
                "dport": "22",
                "action": "ACCEPT",
                "comment": "Allow SSH"
            },
            {
                "type": "in",
                "proto": "tcp",
                "dport": "3000",
                "action": "ACCEPT",
                "comment": "Allow App"
            }
        ]
    }
}

