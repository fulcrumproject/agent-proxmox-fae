@baseUrl = http://localhost:3000/api/v1
@adminToken = change-me
@testSSHKey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIAuETCtsaepU0mPIGai3yAAX4hguQ6XQss0wCkVqopLt test-vm-key@fulcrum

### Create Service Option Type for VM Templates
# @name createTemplateOptionType
POST {{baseUrl}}/service-option-types
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
    "name": "VM Template {{$timestamp}}",
    "type": "vm_template_{{$timestamp}}",
    "description": "Available VM templates for Proxmox VMs"
}

@templateOptionType = {{createTemplateOptionType.response.body.$.type}}

### Create Proxmox VM Service Type
# @name createServiceType
POST {{baseUrl}}/service-types
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Proxmox VM {{$timestamp}}",
  "propertySchema": {
    "properties": {
      "cpu": {
        "type": "integer",
        "label": "CPU Cores",
        "required": true,
        "validators": [
          {
            "type": "min",
            "config": {
              "value": 1
            }
          },
          {
            "type": "max",
            "config": {
              "value": 32
            }
          }
        ]
      },
      "memory": {
        "type": "integer",
        "label": "Memory (MB)",
        "required": true,
        "validators": [
          {
            "type": "min",
            "config": {
              "value": 512
            }
          }
        ]
      },
      "disk": {
        "type": "integer",
        "label": "Disk Size (GB)",
        "required": true,
        "validators": [
          {
            "type": "min",
            "config": {
              "value": 8
            }
          }
        ]
      },
      "template": {
        "type": "string",
        "label": "VM Template",
        "required": true,
        "validators": [
          {
            "type": "serviceOption",
            "config": {
              "value": "{{templateOptionType}}"
            }
          }
        ]
      },
      "netconfig": {
        "type": "json",
        "label": "Network Configuration",
        "immutable": true,
        "authorizers": [
          {
            "type": "actor",
            "config": {
              "actors": ["system"]
            }
          }
        ],
        "generator": {
          "type": "pool",
          "config": {
            "poolType": "netconfig"
          }
        }
      },
      "nameserver": {
        "type": "string",
        "label": "DNS Nameserver",
        "required": false,
        "validators": [
          {
            "type": "pattern",
            "config": {
              "pattern": "^((25[0-5]|(2[0-4]|1\\d|[1-9]|)\\d)\\.?\\b){4}$"
            }
          }
        ]
      },
      "searchdomain": {
        "type": "string",
        "label": "DNS Search Domain",
        "required": false
      },
      "loginuser": {
        "type": "string",
        "label": "Login Username",
        "required": true
      },
      "loginpass": {
        "type": "string",
        "label": "Login Password",
        "required": false,
        "immutable": true,
        "secret": {
          "type": "ephemeral"
        },
        "validators": [
          {
            "type": "minLength",
            "config": {
              "value": 8
            }
          }
        ]
      },
      "loginsshkey": {
        "type": "string",
        "label": "SSH Public Key",
        "required": false,
        "immutable": true,
        "secret": {
          "type": "ephemeral"
        }
      },
      "firewallrules": {
        "type": "array",
        "label": "Firewall Rules",
        "required": false,
        "items": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "required": true,
              "validators": [
                {
                  "type": "enum",
                  "config": {
                    "values": ["in", "out"]
                  }
                }
              ]
            },
            "proto": {
              "type": "string",
              "required": true,
              "validators": [
                {
                  "type": "enum",
                  "config": {
                    "values": ["tcp", "udp"]
                  }
                }
              ]
            },
            "action": {
              "type": "string",
              "required": true,
              "validators": [
                {
                  "type": "enum",
                  "config": {
                    "values": ["ACCEPT", "DROP", "REJECT"]
                  }
                }
              ]
            },
            "source": { "type": "string", "required": false },
            "sport": { "type": "string", "required": false },
            "dest": { "type": "string", "required": false },
            "dport": { "type": "string", "required": false },
            "comment": { "type": "string", "required": false }
          }
        }
      }
    }
  },
  "lifecycleSchema": {
    "states": [
      { "name": "New" },
      { "name": "Stopped" },
      { "name": "Started" },
      { "name": "Deleted" }
    ],
    "actions": [
      {
        "name": "create",
        "requestSchemaType": "properties",
        "transitions": [
          { "from": "New", "to": "Stopped" }
        ]
      },
      {
        "name": "start",
        "transitions": [
          { "from": "Stopped", "to": "Started" }
        ]
      },
      {
        "name": "stop",
        "transitions": [
          { "from": "Started", "to": "Stopped" }
        ]
      },
      {
        "name": "update",
        "requestSchemaType": "properties",
        "transitions": [
          { "from": "Stopped", "to": "Stopped" },
          { "from": "Started", "to": "Started" }
        ]
      },
      {
        "name": "delete",
        "transitions": [
          { "from": "Stopped", "to": "Deleted" },
          { "from": "Started", "to": "Deleted" }
        ]
      }
    ],
    "initialState": "New",
    "terminalStates": ["Deleted"],
    "runningStates": ["Started"]
  }
}

@serviceTypeId = {{createServiceType.response.body.$.id}}

### Create a provider for testing
# @name createProvider
POST {{baseUrl}}/participants
Authorization: Bearer {{adminToken}}

{
    "name": "Demo Service Provider",
    "status": "Enabled"
}

@providerId = {{createProvider.response.body.$.id}}

### Create Service Option - Debian 13 Template
# @name createTemplateOption1
POST {{baseUrl}}/service-options
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
    "providerId": "{{providerId}}",
    "serviceOptionTypeId": "{{createTemplateOptionType.response.body.$.id}}",
    "name": "Debian 13 Template",
    "value": "debian-13-template",
    "enabled": true,
    "displayOrder": 1
}

### List service options for provider (verify they were created)
GET {{baseUrl}}/service-options?providerId={{providerId}}
Authorization: Bearer {{adminToken}}

### Create Agent Type for Proxmox VMs
# @name createAgentType
POST {{baseUrl}}/agent-types
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
    "name": "Proxmox VM Agent {{$timestamp}}",
    "serviceTypeIds": [
        "{{serviceTypeId}}"
    ]
}

@agentTypeId = {{createAgentType.response.body.$.id}}

### Create Service Pool Set for network configuration
# @name createPoolSet
POST {{baseUrl}}/service-pool-sets
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Proxmox Network Pools {{$timestamp}}",
  "providerId": "{{providerId}}"
}

@poolSetId = {{createPoolSet.response.body.$.id}}

### Create Network Configuration Pool (JSON type)
# @name createNetConfigPool
POST {{baseUrl}}/service-pools
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Network Config Pool",
  "type": "netconfig",
  "propertyType": "json",
  "generatorType": "list",
  "servicePoolSetId": "{{poolSetId}}"
}

@poolId = {{createNetConfigPool.response.body.$.id}}

### Add Pool Value
POST {{baseUrl}}/service-pool-values
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "servicePoolId": "{{poolId}}",
  "name": "172.30.173.106",
  "value": {
    "ipaddress": "172.30.173.106",
    "netmask": 24,
    "gateway": "172.30.173.1"
  }
}

### Get Pool Values
GET {{baseUrl}}/service-pool-values?servicePoolId={{poolId}}
Authorization: Bearer {{adminToken}}

### Create an agent with tags and pool set
### NOTE: Set proxmoxApiToken in settings rest-client.environmentVariables
# @name createAgent
POST {{baseUrl}}/agents
Authorization: Bearer {{adminToken}}

{
    "name": "VM Agent",
    "agentTypeId": "{{agentTypeId}}",
    "providerId": "{{providerId}}",
    "servicePoolSetId": "{{poolSetId}}",
    "tags": ["gpu-{{$timestamp}}", "high-memory", "ssd-storage"],
    "configuration": {
        "proxmoxAPI": {
            "apiToken": "{{proxmoxApiToken}}",
            "apiUrl": "https://172.30.173.230:5297",
            "insecureSkipTls": true,
            "timeout": 600,
            "debug": true
        }
   }
}

@agentId = {{createAgent.response.body.$.id}}
@uniqueTag = {{createAgent.response.body.$.tags.[0]}}

### Create a new agent token
# @name createAgentToken
POST {{baseUrl}}/tokens
Authorization: Bearer {{adminToken}}

{
  "name": "Test Agent Token",
  "role": "agent",
  "expireAt": "{{$datetime iso8601 1 y}}",
  "scopeId": "{{agentId}}"
}

@agentToken = {{createAgentToken.response.body.$.value}}

### Get agent's own information via authenticated endpoint
# @name getAgentMe
GET {{baseUrl}}/agents/me
Authorization: Bearer {{agentToken}}

### Create a new consumer
# @name createConsumer
POST {{baseUrl}}/participants
Authorization: Bearer {{adminToken}}

{
  "name": "System Integrator",
  "status": "Enabled"
}

@consumerId = {{createConsumer.response.body.$.id}}

### Create a new consumer token
# @name createConsumerToken
POST {{baseUrl}}/tokens
Authorization: Bearer {{adminToken}}

{
  "name": "System Integrator Token",
  "role": "participant",
  "expireAt": "{{$datetime iso8601 1 y}}",
  "scopeId": "{{consumerId}}"
}

@consumerToken = {{createConsumerToken.response.body.$.value}}

### Create a service group
# @name createServiceGroup
POST {{baseUrl}}/service-groups
Authorization: Bearer {{consumerToken}}

{
    "name": "Project Demo",
    "consumerId": "{{consumerId}}"
}

@serviceGroupId = {{createServiceGroup.response.body.$.id}}

### Create a fully configured VM with firewall rules
# @name createServiceWithFirewall
# Note: netconfig will be allocated from a service pool of type JSON
POST {{baseUrl}}/services
Authorization: Bearer {{consumerToken}}

{
    "name": "Proxmox-VM-Configured-{{uniqueTag}}",
    "properties": {
        "cpu": 2,
        "memory": 2048,
        "disk": 20,
        "template": "ubuntu-24.04-template",
        "nameserver": "1.1.1.1",
        "searchdomain": "opiquad.it",
        "loginuser": "fulcrum",
        "loginsshkey": "{{testSSHKey}}",
        "firewallrules": [
            {
                "type": "in",
                "proto": "tcp",
                "dport": "22",
                "action": "ACCEPT",
                "comment": "Allow SSH"
            },
            {
                "type": "in",
                "proto": "tcp",
                "dport": "80",
                "action": "ACCEPT",
                "comment": "Allow HTTP"
            },
            {
                "type": "in",
                "proto": "tcp",
                "dport": "443",
                "action": "ACCEPT",
                "comment": "Allow HTTPS"
            }
        ]
    },
    "agentTags": ["{{uniqueTag}}"],
    "serviceTypeId": "{{serviceTypeId}}",
    "groupId": "{{serviceGroupId}}"
}

@serviceId = {{createServiceWithFirewall.response.body.$.id}}

### Get a service by ID
GET {{baseUrl}}/services/{{serviceId}}
Authorization: Bearer {{consumerToken}}

### Update name - Should not trigger a job
PATCH {{baseUrl}}/services/{{serviceId}}
Authorization: Bearer {{consumerToken}}

{
    "name": "Proxmox-VM-{{uniqueTag}}-Updated"
}

### Start Service
POST {{baseUrl}}/services/{{serviceId}}/start
Authorization: Bearer {{consumerToken}}

### Get a service by ID
GET {{baseUrl}}/services/{{serviceId}}
Authorization: Bearer {{consumerToken}}

### Hot update vm status
PATCH {{baseUrl}}/services/{{serviceId}}
Authorization: Bearer {{consumerToken}}

{
    "properties": {
        "cpu": 8,
        "memory": 4096
    }
}

